{% extends 'base.html.twig' %}

{% block title %}Inscription - PLCPP{% endblock %}

{% block body %}
<div class="fr-container fr-py-6v">
    <div class="fr-grid-row fr-grid-row--center">
        <div class="fr-col-12 fr-col-md-8 fr-col-lg-6">
            
            <div class="fr-card fr-p-4v">
                <h1 class="fr-h2 fr-mb-4v">Créer votre compte PLCPP</h1>
                <p class="fr-text--sm fr-mb-4v">Identifiez-vous pour accéder à votre espace personnel.</p>

                {{ form_start(registrationForm) }}
                    
                    {# Affichage des erreurs globales #}
                    {% if form_errors(registrationForm) %}
                        <div class="fr-alert fr-alert--error fr-mb-3v">
                            {{ form_errors(registrationForm) }}
                        </div>
                    {% endif %}

                    <div class="fr-input-group">
                        {{ form_label(registrationForm.email, 'Email professionnel', {'label_attr': {'class': 'fr-label'}}) }}
                        {{ form_widget(registrationForm.email, {'attr': {'class': 'fr-input', 'placeholder': 'exemple@sdis.fr'}}) }}
                        {{ form_errors(registrationForm.email) }}
                    </div>

                    <div class="fr-input-group">
                        {{ form_label(registrationForm.prenom, 'Prénom', {'label_attr': {'class': 'fr-label'}}) }}
                        {{ form_widget(registrationForm.prenom, {'attr': {'class': 'fr-input', 'placeholder': 'Raphaël'}}) }}
                        {{ form_errors(registrationForm.prenom) }}
                    </div>

                    <div class="fr-input-group">
                        {{ form_label(registrationForm.nom, 'Nom', {'label_attr': {'class': 'fr-label'}}) }}
                        {{ form_widget(registrationForm.nom, {'attr': {'class': 'fr-input', 'placeholder': 'Nabi'}}) }}
                        {{ form_errors(registrationForm.nom) }}
                    </div>

                    <div class="fr-input-group">
                        {{ form_label(registrationForm.plainPassword, 'Mot de passe', {'label_attr': {'class': 'fr-label'}}) }}
                        {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'fr-input'}}) }}
                        {{ form_errors(registrationForm.plainPassword) }}
                    </div>

                    <div class="fr-mt-4v">
                        <ul class="fr-btns-group">
                            <li>
                                <button type="submit" class="fr-btn">
                                    Créer mon compte
                                </button>
                            </li>
                            <li>
                                <a href="{{ path('app_login') }}" class="fr-btn fr-btn--secondary">
                                    Déjà inscrit ? Se connecter
                                </a>
                            </li>
                        </ul>
                    </div>
                {{ form_end(registrationForm) }}
            </div>

        </div>
    </div>
</div>
{% endblock %}